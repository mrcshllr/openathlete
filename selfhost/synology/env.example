# =============================================================================
# OpenAthlete auf der Synology - Einstellungen
# =============================================================================
# install.sh legt diese Datei als .env an und füllt die Geheimnisse selbst.
# Sie gehört nie auf GitHub. Sichere sie (Hyper Backup): ohne HASH_PEPPER
# funktioniert kein Passwort mehr.
# Alle Variablen: https://github.com/openathleteorg/openathlete/blob/main/.env.example
# =============================================================================

COMPOSE_PROJECT_NAME=openathlete

# --- Geheimnisse (von install.sh erzeugt, nie mehr ändern) ------------------
JWT_SECRET_KEY=
HASH_PEPPER=
POSTGRES_PASSWORD=

# --- Adresse ----------------------------------------------------------------
# Die öffentliche Adresse über den Cloudflare Tunnel
APP_URL=https://training.marcushaller.de
# Port 80/443 gehören DSM, 8000/9000 Portainer: die Oberfläche läuft auf
# 9999 im Heimnetz, der Tunnel leitet https://training.marcushaller.de dorthin
WEB_PORT=9999
# Die API direkt, nur auf dem NAS selbst (die App nimmt den Weg über /api)
API_PORT=127.0.0.1:3999
# closed: niemand kann sich registrieren. Das erste Konto geht trotzdem.
SIGNUP_MODE=closed

# --- Images aus meinem Fork -------------------------------------------------
# selfhost = der neueste nächtliche Build. Zum Zurückgehen ein datiertes Tag
# eintragen, z. B. selfhost-20261113-73abf46 (Liste: github.com/mrcshllr?tab=packages)
OPENATHLETE_VERSION=selfhost
# Von wem update.sh die Images nimmt
IMAGE_OWNER=mrcshllr

# --- Strava (strava.com/settings/api) ---------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Zufallswort für den Webhook (von install.sh erzeugt), siehe strava-webhook.sh
STRAVA_WEBHOOK_TOKEN=

# --- Suunto (apizone.suunto.com, nach Freigabe als Partner) -----------------
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=
SUUNTO_WEBHOOK_SECRET=

# --- E-Mail (optional, z. B. mailbox.org) -----------------------------------
# Ohne SMTP gibt es keine Mails (Passwort vergessen, Einladungen)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- KI (optional) ----------------------------------------------------------
# Leer lassen: eigene Schlüssel trägst du in der App unter Einstellungen > KI ein
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL_DEFAULT=

# --- Hintergrundjobs: im selben Container, für Geräte-Sync nötig ------------
ENABLE_ACTIVITY_IMPORT=true
ENABLE_ACTIVITY_PROCESSING=true
ENABLE_TRAINING_LOAD_ESTIMATION=false
